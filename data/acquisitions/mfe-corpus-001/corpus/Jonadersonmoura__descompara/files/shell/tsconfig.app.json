{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../dist/out-tsc",
    "types": [],
    "target": "ES2020"
  },
  "include": [
    "src/**/*.ts",
    "../libs/shared/guards/src/index.ts",
    "../libs/shared/data-access/src/index.ts",
    "../libs/shared/types/src/index.ts",
    "../libs/shared/ui/src/index.ts",
    "../libs/shared/theme/src/index.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/test-setup.ts"
  ],
  "references": [
    {
      "path": "../libs/shared/theme/tsconfig.lib.json"
    },
    {
      "path": "../libs/shared/ui/tsconfig.lib.json"
    },
    {
      "path": "../libs/shared/guards/tsconfig.lib.json"
    }
  ]
}