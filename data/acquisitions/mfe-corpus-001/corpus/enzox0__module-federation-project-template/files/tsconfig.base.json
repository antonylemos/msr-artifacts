{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@mf/ui": ["./packages/ui/src/index.ts"],
      "@mf/shared": ["./packages/shared/src/index.ts"],
      "@mf/types": ["./packages/types/src/index.ts"],
      "@mf/sdk": ["./packages/sdk/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
