{
  "name": "zephyr-mfe-test",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "install:all": "npm install && cd apps/host && npm install && cd ../remote-header && npm install && cd ../remote-footer && npm install && cd ../url-shortener && npm install",
    "dev:host": "cd apps/host && npm run dev",
    "dev:header": "cd apps/remote-header && npm run dev",
    "dev:footer": "cd apps/remote-footer && npm run dev",
    "dev:shortener": "cd apps/url-shortener && npm run start",
    "dev:all": "concurrently \"npm run dev:header\" \"npm run dev:footer\" \"npm run dev:shortener\" \"npm run dev:host\"",
    "build:host": "cd apps/host && npm run build",
    "build:header": "cd apps/remote-header && npm run build",
    "build:footer": "cd apps/remote-footer && npm run build",
    "build:shortener": "cd apps/url-shortener && npm run build",
    "build:all": "npm run build:header && npm run build:footer && npm run build:shortener && npm run build:host",
    "serve:host": "cd apps/host && npm run serve",
    "serve:header": "cd apps/remote-header && npm run serve",
    "serve:footer": "cd apps/remote-footer && npm run serve",
    "serve:shortener": "cd apps/url-shortener && npm run serve",
    "serve:all": "concurrently \"npm run serve:header\" \"npm run serve:footer\" \"npm run serve:shortener\" \"npm run serve:host\"",
    "start:host": "cd apps/host && npm start",
    "start:header": "cd apps/remote-header && npm start",
    "start:footer": "cd apps/remote-footer && npm start",
    "start:shortener": "cd apps/url-shortener && npm start",
    "start:all": "concurrently \"npm run start:header\" \"npm run start:footer\" \"npm run start:shortener\" \"npm run start:host\"",
    "clean": "rm -rf apps/*/dist apps/*/node_modules node_modules",
    "clean:build": "rm -rf apps/*/dist",
    "lint": "cd apps/host && npm run lint && cd ../remote-header && npm run lint && cd ../remote-footer && npm run lint",
    "type-check": "cd apps/host && npm run type-check && cd ../remote-header && npm run type-check && cd ../remote-footer && npm run type-check"
  },
  "devDependencies": {
    "@rspack/cli": "~1.2.0",
    "@rspack/core": "~1.2.0",
    "@rspack/plugin-react-refresh": "~1.0.1",
    "@types/body-parser": "^1.19.5",
    "@types/eslint": "^9.6.1",
    "@types/http-errors": "^2.0.4",
    "@types/node": "^22.15.21",
    "@types/node-fetch": "^2.6.12",
    "@types/qs": "^6.14.0",
    "@types/range-parser": "^1.2.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/send": "^0.17.4",
    "@types/webpack-env": "^1.18.8",
    "autoprefixer": "^10.1.0",
    "concurrently": "^8.2.2",
    "css-loader": "^7.1.2",
    "postcss": "^8.2.1",
    "postcss-loader": "^8.0.0",
    "react-refresh": "^0.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vue-loader": "^17.0.0",
    "@vue/compiler-sfc": "^3.4.0"
  },
  "dependencies": {
    "@module-federation/enhanced": "^0.8.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "style-loader": "^4.0.0",
    "vue": "^3.4.0",
    "zephyr-webpack-plugin": "^0.0.39"
  }
}
