  "projects": {
    "01-angular": {
      "projectType": "application",
      "root": "exemplos/01-componentes/angular",
      "sourceRoot": "exemplos/01-componentes/angular/src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "exemplos/01-componentes/angular/src/main.ts",
            "index": "exemplos/01-componentes/angular/src/index.html",
            "tsConfig": "exemplos/01-componentes/angular/tsconfig.json",
            "styles": [
              "material/estilos.css"
            ],
            "outputPath": "exemplos/01-componentes/angular/dist",
            "assets": []
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "exemplos/01-componentes/angular/proxy.conf.json"
          },
          "configurations": {
            "development": {
              "buildTarget": "01-angular:build:development"
            },
            "production": {
              "buildTarget": "01-angular:build:production"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
