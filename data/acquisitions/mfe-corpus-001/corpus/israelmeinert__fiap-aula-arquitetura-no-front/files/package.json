{
  "name": "eventflow-material-arquitetura-front-end",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "workspaces": [
    "exemplos/*/react",
    "exemplos/*/angular",
    "exemplos/*/next",
    "exemplos/*/astro",
    "exemplos/*/apps/*"
  ],
  "scripts": {
    "aula": "node scripts/aula.mjs",
    "api": "node mocks/server.mjs",
    "cenario": "node scripts/cenario.mjs",
    "check": "node scripts/fronteiras.mjs && node scripts/typecheck.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "next": "16.3.8",
    "astro": "7.3.6",
    "@astrojs/react": "7.0.1",
    "@angular/core": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/platform-server": "22.2.1",
    "@angular/router": "22.2.1",
    "@angular/ssr": "22.2.1",
    "rxjs": "7.8.2",
    "express": "5.2.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "typescript": "6.0.2",
    "vite": "8.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "vitest": "5.0.3",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "22.20.5",
    "@types/express": "5.0.6",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "@babel/core": "8.0.5"
  }
}
