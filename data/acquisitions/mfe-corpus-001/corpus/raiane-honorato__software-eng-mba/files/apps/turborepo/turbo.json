{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["**/tsconfig.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "outputs": [],
      "cache": false
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "test": {
      "outputs": [],
      "inputs": ["src/**", "**/__tests__/**", "jest.config.*"]
    }
  }
}
