        ],
        "regex": "\\bat\\s+runtime\\b|\\bruntime\\s+(load|loading|integration|composition)",
        "ignoreCase": true,
        "rationale": "Loading or composition at runtime described in the documentation"
      },
      {
        "id": "doc-independence",
        "artifactTypes": [
          "documentation"
        ],
        "regex": "independen(t|tly)|autonom(y|ous)|deployed?\\s+separately",
        "ignoreCase": true,
        "rationale": "Independence of units claimed in the documentation"
      },
      {
        "id": "doc-host-remote",
        "artifactTypes": [
          "documentation"
        ],
        "regex": "\\b(host|shell|container)\\b.*\\bremotes?\\b|\\bremotes?\\b.*\\b(host|shell|container)\\b",
        "ignoreCase": true,
        "rationale": "Host and remote roles described in the documentation"
      },
      {
        "id": "ws-workspaces",
        "artifactTypes": [
          "workspace-config"
        ],
        "regex": "\"workspaces\"\\s*:|^packages\\s*:",
        "rationale": "Workspace declaration that groups several packages in one repository"
      },
      {
        "id": "ws-path-alias",
        "artifactTypes": [
          "workspace-config"
        ],
        "regex": "\"paths\"\\s*:",
        "rationale": "Path mapping, which is how units usually consume a shared local library"
      }
